; /etc/bind/zones/db.192.168.8 - router transit reverse zone
$TTL 3600
@   IN SOA dns-dhcp.corp.local. admin.corp.local. (
        2026092202  ; serial (YYYYMMDDnn)
        3600        ; refresh
        900         ; retry
        604800      ; expire
        300 )       ; negative cache TTL
;
@   IN NS dns-dhcp.corp.local.
; Transit 192.168.8.192/30
193 IN PTR r1.corp.local.
194 IN PTR r2.corp.local.
