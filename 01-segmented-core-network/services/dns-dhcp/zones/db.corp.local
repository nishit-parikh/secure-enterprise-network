; /etc/bind/zones/db.corp.local - PRIVATE view (every internal host)
$TTL 3600
@   IN SOA dns-dhcp.corp.local. admin.corp.local. (
        2026100507  ; serial (YYYYMMDDnn)
        3600        ; refresh
        900         ; retry
        604800      ; expire
        300 )       ; negative cache TTL
;
@   IN NS dns-dhcp.corp.local.

; ---- Routers ----
r1          IN A 192.168.8.193
r1          IN A 10.10.30.1
r2          IN A 10.10.10.1
r2          IN A 192.168.8.194
r2          IN A 172.16.0.1

; ---- Users ----
admin       IN A 172.16.0.2

; ---- Infrastructure ----
ad          IN A 10.10.10.10
dns-dhcp    IN A 10.10.10.11
file        IN A 10.10.10.12
internal    IN A 10.10.10.13

; ---- DMZ ----
public      IN A 10.10.30.10
shop        IN A 10.10.30.11
dns-public  IN A 10.10.30.12

; ---- Domain apex points at the domain controller ----
@           IN A 10.10.10.10

; ---- Active Directory locator records ----
_gc._tcp                IN SRV 0 100 3268 ad.corp.local.
_ldap._tcp              IN SRV 0 100 389  ad.corp.local.
_ldap._tcp.dc._msdcs    IN SRV 0 100 389  ad.corp.local.
_ldap._tcp.pdc._msdcs   IN SRV 0 100 389  ad.corp.local.
_kerberos._tcp          IN SRV 0 100 88   ad.corp.local.
_kerberos._tcp.dc._msdcs IN SRV 0 100 88  ad.corp.local.
_kpasswd._tcp           IN SRV 0 100 464  ad.corp.local.
