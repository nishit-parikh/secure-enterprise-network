// /etc/bind/named.conf.local - dns-dhcp (PRIVATE DNS)
// Authoritative for the full internal view of corp.local plus all reverse zones.

zone "corp.local" {
    type master;
    file "/etc/bind/zones/db.corp.local";
};

// Router transit 192.168.8.192/30
zone "8.168.192.in-addr.arpa" {
    type master;
    file "/etc/bind/zones/db.192.168.8";
};

// Users
zone "0.16.172.in-addr.arpa" {
    type master;
    file "/etc/bind/zones/db.172.16.0";
};

// Infrastructure
zone "10.10.10.in-addr.arpa" {
    type master;
    file "/etc/bind/zones/db.10.10.10";
};

// DMZ
zone "30.10.10.in-addr.arpa" {
    type master;
    file "/etc/bind/zones/db.10.10.30";
};
