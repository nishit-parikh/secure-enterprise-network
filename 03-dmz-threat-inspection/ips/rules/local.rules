# Custom Suricata signatures for the DMZ inline IPS.
# Installed to /var/lib/suricata/rules/local.rules (the directory Suricata loads from).
#
# 9000001-9000003 and 9000005 DROP (prevention); 9000004 only ALERTs, on purpose,
# to give a detect-versus-prevent comparison in the evidence.

drop http any any -> any any (msg:"CUSTOM-IPS SQLi union select"; flow:to_server; http.uri; content:"union"; nocase; content:"select"; nocase; distance:0; sid:9000001; rev:1;)
drop http any any -> any any (msg:"CUSTOM-IPS XSS script tag"; flow:to_server; http.uri; content:"<script"; nocase; sid:9000002; rev:1;)
drop http any any -> any any (msg:"CUSTOM-IPS path traversal"; flow:to_server; http.uri; content:"../"; sid:9000003; rev:1;)
alert http any any -> any any (msg:"CUSTOM-IPS command injection"; flow:to_server; http.uri; content:"whoami"; nocase; sid:9000004; rev:3;)
drop tcp any any -> any any (msg:"CUSTOM-IPS nmap SYN scan"; flags:S; flow:to_server; threshold:type both,track by_src,count 20,seconds 5; sid:9000005; rev:1;)
